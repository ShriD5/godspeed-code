{
  // Godspeed edge: per-session + per-workspace sync DOs, per-device relay
  // DOs, R2 blobs, and the absorbed WorkOS auth routes.
  // Design: loro-sessions §2 (topology), §3 (persistence), §6.1 (diff
  // sidecar), §8 (device-room streams), §1.2 (R2 attachments), §3.3 (R2
  // backups); ARCHITECTURE.md §6.
  // Deploy steps, secrets and vars: edge/DEPLOY.md. This is a fresh
  // deployment on the owner's account; Durable Object storage is bound to the
  // script name, so don't rename the worker once it holds real data.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "godspeed-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "account_id": "f715952f0d5650529fe9401bcca31e2e",
  // Served at https://godspeed-edge.<account-subdomain>.workers.dev. No
  // custom-domain routes: Zeron's zeron.sh routes (edge host, install.sh and
  // /releases/* carve-outs) belonged to Zeron's zone.
  "workers_dev": true,
  // Lets src/index.ts import src/install.sh as a string. The /install.sh and
  // /releases/* routes answer 404 unless a RELEASES bucket is bound (it
  // isn't: Godspeed ships releases on GitHub, and install.sh is Zeron's).
  "rules": [{ "type": "Text", "globs": ["**/*.sh"], "fallthrough": true }],
  // loro-crdt's default entry loads its WASM via URL fetch, which workerd
  // cannot do at runtime; the base64 entry inlines the module instead.
  "alias": {
    "loro-crdt": "loro-crdt/base64"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_ROOMS", "class_name": "SessionRoom" },
      { "name": "DEVICE_ROOMS", "class_name": "DeviceRoom" },
      { "name": "PREVIEW_ROOMS", "class_name": "PreviewRoom" },
      { "name": "REGISTRY_ROOMS", "class_name": "RegistryRoom" },
      { "name": "CHAT_ROOMS", "class_name": "ChatRoom" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionRoom", "DeviceRoom"]
    },
    {
      // Workspace registry (docs/registry-sync.md) — the row-table sidebar
      // sync that replaces the Loro workspace doc rooms.
      "tag": "v2",
      "new_sqlite_classes": ["RegistryRoom"]
    },
    {
      // chat2 session rooms (docs/chat2-sync.md) — dumb log relays that
      // replace SessionRoom's loro-aware s2 rooms.
      "tag": "v3",
      "new_sqlite_classes": ["ChatRoom"]
    },
    { "tag": "v4", "new_sqlite_classes": ["PreviewRoom"] }
  ],
  "r2_buckets": [
    {
      // Tool-output sidecars, attachments, chat checkpoints and backups.
      "binding": "BLOBS",
      "bucket_name": "godspeed-blobs"
    }
    // A RELEASES binding (bucket "godspeed-releases") would re-enable the
    // /releases/* + /install.sh surface; left out on purpose (DEPLOY.md).
  ],
  // Light per-IP limit on /auth/* (src/auth-routes.ts). Counters are per
  // Cloudflare location and approximate; drop this block to disable.
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "vars": {
    // WorkOS AuthKit client id: JWTs are verified against its JWKS. Left as
    // a placeholder until the sign-in method is chosen, so every bearer is
    // rejected (fail closed). Zeron's own client id was removed: keeping it
    // would let any Zeron account use this edge. Secrets (WORKOS_API_KEY,
    // APNS_KEY_P8, APNS_KEY_ID) are listed in DEPLOY.md.
    "WORKOS_CLIENT_ID": "client_01M52B7VJ0PRXA4Y63HQKYYRA8",
    "AUTH_MODE": "workos",
    // Push: the Godspeed iOS app's team and bundle id (defaults in env.ts).
    "APNS_TEAM_ID": "QPUV967B5U",
    "APNS_TOPIC": "site.shrithan.godspeed.ios"
  },
  "observability": {
    "enabled": true
  }
}
